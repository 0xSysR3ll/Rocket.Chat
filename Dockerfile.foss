# Simple Dockerfile for Rocket.Chat FOSS
FROM node:22.16.0-bullseye-slim

LABEL maintainer="rocket.chat.foss"

# Install Deno
ENV DENO_VERSION=1.43.5
RUN ARCH= && dpkgArch="$(dpkg --print-architecture)" \
    && case "${dpkgArch##*-}" in \
    amd64) ARCH='x86_64';; \
    arm64) ARCH='aarch64';; \
    *) echo "unsupported Deno architecture"; exit 1 ;; \
    esac \
    && set -ex \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://dl.deno.land/release/v${DENO_VERSION}/deno-${ARCH}-unknown-linux-gnu.zip --output /tmp/deno-${ARCH}-unknown-linux-gnu.zip \
    && unzip /tmp/deno-${ARCH}-unknown-linux-gnu.zip -d /tmp \
    && rm /tmp/deno-${ARCH}-unknown-linux-gnu.zip \
    && chmod 755 /tmp/deno \
    && mv /tmp/deno /usr/local/bin/deno

# Create rocketchat user
RUN groupadd -r rocketchat \
    && useradd -r -g rocketchat rocketchat \
    && mkdir -p /app/uploads \
    && chown rocketchat:rocketchat /app/uploads

VOLUME /app/uploads

WORKDIR /app

ENV NODE_ENV=production

# Copy the built bundle (built locally)
COPY --chown=rocketchat:rocketchat bundle/ /app/bundle/

USER rocketchat

WORKDIR /app/bundle/bundle

# Environment variables
ENV DEPLOY_METHOD=docker-foss \
    MONGO_URL=mongodb://db:27017/meteor \
    HOME=/tmp \
    PORT=3000 \
    ROOT_URL=http://localhost:3000

EXPOSE 3000

CMD ["node", "main.js"]
